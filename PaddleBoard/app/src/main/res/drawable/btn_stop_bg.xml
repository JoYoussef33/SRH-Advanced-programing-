<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#22FF6B35"/>
            <size android:width="200dp" android:height="200dp"/>
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="#44FF6B35"/>
            <size android:width="184dp" android:height="184dp"/>
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="100%"
                android:startColor="#FF6B35"
                android:endColor="#CC4400"
                android:centerX="0.5"
                android:centerY="0.4"/>
            <size android:width="168dp" android:height="168dp"/>
        </shape>
    </item>
</layer-list>
