<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628">

    <!-- Full-screen photo background -->
    <ImageView
        android:id="@+id/imgResultPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- Dark gradient over photo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/result_overlay"/>

    <!-- Scrollable content card from bottom -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:paddingTop="80dp">

            <!-- Tier label -->
            <TextView
                android:id="@+id/tvTierLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_marginBottom="12dp"/>

            <!-- Big message -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-condensed"/>

            <!-- Personal records broken this session -->
            <TextView
                android:id="@+id/tvRecords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/sun_yellow"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- Stats glass card -->
            <LinearLayout
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glass_card"
                android:padding="24dp"
                android:layout_marginBottom="24dp">

                <!-- Date row -->
                <TextView
                    android:id="@+id/tvResDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#A0D4F0"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Start / End -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/tvResStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#80C0E0"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/tvResEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="#80C0E0"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Divider -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#1A1E4A7A" android:layout_marginBottom="16dp"/>

                <!-- Big stat row: distance + duration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📍" android:textSize="20sp"/>
                        <TextView android:id="@+id/tvResDistance"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/wave_cyan" android:textSize="28sp"
                            android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DISTANCE" android:textColor="#607090"
                            android:textSize="10sp" android:letterSpacing="0.15"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="#1A1E4A7A"/>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⏱" android:textSize="20sp"/>
                        <TextView android:id="@+id/tvResDuration"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/wave_teal" android:textSize="28sp"
                            android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DURATION" android:textColor="#607090"
                            android:textSize="10sp" android:letterSpacing="0.15"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Calories + max speed row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🔥" android:textSize="20sp"/>
                        <TextView android:id="@+id/tvResCalories"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/sun_coral" android:textSize="28sp"
                            android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CALORIES" android:textColor="#607090"
                            android:textSize="10sp" android:letterSpacing="0.15"/>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent"
                        android:background="#1A1E4A7A"/>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⚡" android:textSize="20sp"/>
                        <TextView android:id="@+id/tvResMaxSpeed"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/sun_yellow" android:textSize="28sp"
                            android:textStyle="bold" android:fontFamily="sans-serif-condensed"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="MAX SPEED" android:textColor="#607090"
                            android:textSize="10sp" android:letterSpacing="0.15"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="40dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDiscard"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_outline"
                    android:text="DISCARD"
                    android:textColor="#6600D4FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:stateListAnimator="@null"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_save"
                    android:text="SAVE SESSION"
                    android:textColor="@color/ocean_deep"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
